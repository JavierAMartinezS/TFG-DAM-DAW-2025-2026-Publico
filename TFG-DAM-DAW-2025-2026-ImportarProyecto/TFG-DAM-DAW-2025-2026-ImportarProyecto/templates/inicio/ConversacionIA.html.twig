{% extends 'base.html.twig' %}

{% block title %}Viajes | TripPlanner{% endblock %}

{% block body %}
    {% block content %}
        <div class="container-fluid py-4">
            <div class="ia-layout">
                <div class="ia-chat-panel">
                    <h3>Asistente IA</h3>
                    <div class="ia-trip-summary">
                        <ul>
                            <li><strong>Tipo de viaje:</strong> {{ viaje.tipoViaje }}</li>
                            <li><strong>Viajeros:</strong> {{ viaje.numViajeros }}</li>
                            <li><strong>Fechas:</strong> {{ viaje.fechas }}</li>
                            <li><strong>Presupuesto:</strong> {{ viaje.presupuesto }}€</li>
                        </ul>
                    </div>
                    <div class="ia-chat-window"></div>
                    <div class="ia-chat-input">
                        <input type="text" placeholder="Escribe tu mensaje...">
                        <button>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#fff" class="bi bi-send-fill" viewBox="0 0 16 16">
                                <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471z"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="ia-map-panel">
                    <div class="ia-map-sidebar"></div>
                    <div class="ia-map-canvas">MAPA</div>
                </div>
            </div>
        </div>

        {% set datos_viaje = viaje is defined and viaje ? viaje : {
            tipoViaje: null,
            numViajeros: null,
            fechas: null,
            presupuesto: null,
            fechaInicioExacta: null,
            fechaFinExacta: null,
            duracion: null
        } %}
        <script>
            window.viaje = {{ datos_viaje|json_encode|raw }};
        </script>

        <script src="{{ asset('js/ConversacionConIA.js') }}"></script>
    {% endblock %}
{% endblock %}